# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# `/out/` is the static export that Cloudflare Pages serves. It is a build
# artefact and is never committed. `/public/` is source and MUST stay tracked —
# the CV PDFs and the car-tracker screenshots live there.
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nothing here needs one, and none should ever be committed
.env
.env.*
!.env.example

# hosting CLIs
.vercel
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts
